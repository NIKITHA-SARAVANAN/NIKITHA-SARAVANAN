# Environment Configuration
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://srs_user:srs_password@localhost:5432/srs_generator
REDIS_URL=redis://localhost:6379
DATABASE_ECHO=true

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.2
MAX_TOKENS=4000

# Agent Configuration
MAX_AGENT_RETRIES=3
HUMAN_APPROVAL_TIMEOUT=300
ENABLE_AUTO_ROLLBACK=true
AGENT_EXECUTION_TIMEOUT=600
MAX_CONCURRENT_AGENTS=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=srs-generator

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=localhost
FRONTEND_PORT=8501
DEBUG=true

# File Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,md,txt
UPLOAD_DIR=uploads/

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# MCP Server Configuration
MCP_FILE_SERVER_PORT=3001
MCP_SEARCH_SERVER_PORT=3002
MCP_VALIDATION_SERVER_PORT=3003

# Code Generation Configuration
OUTPUT_DIR=output/
BACKUP_ENABLED=true
GIT_AUTO_COMMIT=false
DOCKER_EXPORT=false

# Performance Configuration
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1000
KEEP_ALIVE_TIMEOUT=5